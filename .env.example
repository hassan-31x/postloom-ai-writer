# Separate MongoDB Atlas database, never the office database. Atlas must allow Vercel connectivity.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/postloom?retryWrites=true&w=majority"
AUTH_SECRET=""
# Set to the final production origin. Local development uses http://localhost:3000.
APP_URL="http://localhost:3000"
RESEND_API_KEY=""
EMAIL_FROM="Postloom <hello@your-domain.com>"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash-lite"
AI_DAILY_LIMIT="20"
AI_GLOBAL_DAILY_LIMIT="1000"
# Optional image generation, disabled by default to keep the free plan inexpensive.
ENABLE_IMAGE_GENERATION="false"
OPENROUTER_IMAGE_MODEL="bytedance-seed/seedream-4.5"
IMAGE_DAILY_LIMIT="2"
IMAGE_GLOBAL_DAILY_LIMIT="20"
# Required before launch, shown in privacy and terms pages.
SUPPORT_EMAIL=""
